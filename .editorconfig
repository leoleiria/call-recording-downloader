root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format, enforced by Spotless (./mvnw spotless:apply)
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{cmd,ps1}]
end_of_line = crlf
