# Normalize line endings in the repository; check out with the platform default.
* text=auto

# Scripts keep the line endings their interpreter expects.
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Translations and sources are UTF-8 text.
*.java text diff=java
*.properties text
*.md text diff=markdown

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.mp3 binary
