<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.leoleiria</groupId>
    <artifactId>call-recording-downloader-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>call-recording-downloader-ringover-client</artifactId>
  <name>Call Recording Downloader :: Ringover client</name>
  <description>
    HTTP adapter for the Ringover public API: call search, media downloads and transcriptions,
    with rate limiting and retries.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.leoleiria</groupId>
      <artifactId>call-recording-downloader-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Tests run a local fake Ringover server built on the JDK's jdk.httpserver module. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-modules</arg>
                <arg>jdk.httpserver</arg>
                <arg>--add-reads</arg>
                <arg>io.github.leoleiria.callrecording.ringover=jdk.httpserver</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>
            --add-modules jdk.httpserver
            --add-reads io.github.leoleiria.callrecording.ringover=jdk.httpserver
          </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
