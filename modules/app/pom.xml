<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.leoleiria</groupId>
    <artifactId>call-recording-downloader-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>call-recording-downloader-app</artifactId>
  <name>Call Recording Downloader :: Desktop app</name>
  <description>JavaFX desktop user interface.</description>

  <properties>
    <app.module>io.github.leoleiria.callrecording.app</app.module>
    <app.mainClass>io.github.leoleiria.callrecording.app.Launcher</app.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.leoleiria</groupId>
      <artifactId>call-recording-downloader-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.leoleiria</groupId>
      <artifactId>call-recording-downloader-ringover-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>call-recording-downloader</finalName>
    <resources>
      <!-- Only app.properties is filtered (version, URL); everything else is copied as is. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>app.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>app.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <!-- `mvnw -pl modules/app -am javafx:run` starts the app from source. -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>${app.module}/${app.mainClass}</mainClass>
        </configuration>
      </plugin>

      <!-- Copies every runtime module next to the app jar; jpackage uses this folder. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-modules</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/modules</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${project.build.directory}/modules</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
