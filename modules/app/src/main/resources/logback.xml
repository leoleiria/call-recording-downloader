<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration.

  Secrets: %msg and %ex are replaced by converters that mask API keys and Authorization values.
  Never add patterns that print MDC, request headers or raw arguments.
-->
<configuration>
  <conversionRule conversionWord="msg"
                  class="io.github.leoleiria.callrecording.app.logging.RedactingMessageConverter"/>
  <conversionRule conversionWord="ex"
                  class="io.github.leoleiria.callrecording.app.logging.RedactingThrowableConverter"/>

  <!-- Must match AppInfo.logFolder(). The crd.logDir system property overrides it (tests). -->
  <property name="LOG_DIR" value="${crd.logDir:-${user.home}/.call-recording-downloader/logs}"/>
  <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>5MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>50MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${PATTERN}</pattern>
    </encoder>
  </appender>

  <logger name="io.github.leoleiria.callrecording" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
